{
  "name": "dsh-code-intelligence",
  "version": "0.1.0",
  "description": "DSH code intelligence: TypeScript, Python, and Kotlin LSP navigation plus read-only AST search.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./lsp-config": "./lib/lsp-config.cjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "VALIDATION.md",
    "scripts/fetch-kotlin.mjs",
    "skill"
  ],
  "engines": {
    "node": ">=22.22.2",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaxhu1108/dsh-code-intelligence.git"
  },
  "homepage": "https://github.com/jaxhu1108/dsh-code-intelligence#readme",
  "bugs": {
    "url": "https://github.com/jaxhu1108/dsh-code-intelligence/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "language-server",
    "ast-grep",
    "typescript",
    "python",
    "kotlin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.0",
    "pyright": "1.1.414",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.2"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/verify-dsh.mjs",
    "fetch-kotlin": "node scripts/fetch-kotlin.mjs"
  }
}
